FROM ubuntu:noble

ARG DEBIAN_FRONTEND=noninteractive
ARG OXIDIZED_VERSION=0.37.0

ENV OXIDIZED_HOME=/etc/oxidized
ENV PATH="/usr/local/bin:${PATH}"

RUN set -eux; \
  apt-get update; \
  \
  # Runtime deps
  apt-get install -y --no-install-recommends --no-install-suggests \
    ruby \
    ruby-rugged \
    bash \
    msmtp \
    git \
    ca-certificates \
  ; \
  \
  # Build deps (temporary)
  apt-get install -y --no-install-recommends --no-install-suggests \
    ruby-dev \
    g++ \
    make \
    cmake \
    pkg-config \
    libssl-dev \
    libssh2-1-dev \
    libicu-dev \
    zlib1g-dev \
    libsqlite3-dev \
    libffi-dev \
  ; \
  \
  # Install gems
  gem install --no-document "oxidized:${OXIDIZED_VERSION}" oxidized-web; \
  \
  # Install helper script into stable PATH location
  GEM_DIR="$(ruby -e 'print Gem.default_dir')"; \
  install -m 0755 \
    "${GEM_DIR}/gems/oxidized-${OXIDIZED_VERSION}/extra/oxidized-report-git-commits" \
    /usr/local/bin/oxidized-report-git-commits; \
  \
  # Create runtime dirs and user
  mkdir -p "${OXIDIZED_HOME}" /var/lib/oxidized; \
  groupadd --system oxidized; \
  useradd  --system --gid oxidized --home-dir /home/oxidized --create-home oxidized; \
  chown -R oxidized:oxidized "${OXIDIZED_HOME}" /var/lib/oxidized /home/oxidized; \
  \
  # Cleanup
  find "${GEM_DIR}/cache" -mindepth 1 -delete || true; \
  apt-get purge -y \
    ruby-dev g++ make cmake pkg-config \
    libssl-dev libssh2-1-dev libicu-dev zlib1g-dev libsqlite3-dev libffi-dev \
  ; \
  apt-get autoremove -y --purge; \
  rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

USER oxidized
WORKDIR ${OXIDIZED_HOME}

EXPOSE 8888
VOLUME ["/etc/oxidized", "/var/lib/oxidized"]

CMD ["oxidized"]

LABEL org.opencontainers.image.authors="Will Brickles" \
      org.opencontainers.image.title="oxidized" \
      org.opencontainers.image.description="Software to backup network switch configurations" \
      org.opencontainers.image.version="${OXIDIZED_VERSION}"
