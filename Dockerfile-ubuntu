FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG OXIDIZED_VERSION=0.38.0
ARG OXIDIZED_WEB_VERSION=0.18.1
ARG RUGGED_VERSION=1.9.0

ENV OXIDIZED_HOME=/etc/oxidized \
    HOME=/home/oxidized \
    LANG=C.UTF-8 \
    PATH="/usr/local/bin:${PATH}"

LABEL org.opencontainers.image.authors="Will Brickles" \
      org.opencontainers.image.title="Oxidized" \
      org.opencontainers.image.description="Network device configuration backup service" \
      org.opencontainers.image.version="${OXIDIZED_VERSION}" \
      org.opencontainers.image.licenses="Apache-2.0"

# Install runtime dependencies, compile gems, and remove build
# dependencies in a single layer to minimize final image size.
RUN set -eux; \
    apt-get update; \
    \
    # Runtime dependencies
    apt-get install -y --no-install-recommends \
      ruby \
      bash \
      msmtp \
      git \
      ca-certificates \
      tini \
      libssl3t64 \
      libssh2-1t64 \
      libicu74 \
      zlib1g \
      libzstd1 \
      libyaml-0-2 \
      libsqlite3-0 \
      libffi8 \
      libstdc++6 \
    ; \
    \
    # Temporary build dependencies
    apt-get install -y --no-install-recommends \
      ruby-dev \
      g++ \
      make \
      cmake \
      pkg-config \
      libssl-dev \
      libssh2-1-dev \
      libicu-dev \
      zlib1g-dev \
      libzstd-dev \
      libyaml-dev \
      libsqlite3-dev \
      libffi-dev \
    ; \
    \
    # Install pinned Ruby gems
    gem install --no-document rugged -v "${RUGGED_VERSION}"; \
    gem install --no-document oxidized -v "${OXIDIZED_VERSION}"; \
    gem install --no-document oxidized-web -v "${OXIDIZED_WEB_VERSION}"; \
    \
    # Install a newer JSON gem
    gem install --no-document json -v '~> 2.8'; \
    # Install a compatible SCP
    gem install --no-document net-scp -v '~> 4.2'; \
    \
    # Install Git reporting helper
    GEM_DIR="$(ruby -e 'print Gem.default_dir')"; \
    install -m 0755 \
      "${GEM_DIR}/gems/oxidized-${OXIDIZED_VERSION}/extra/oxidized-report-git-commits" \
      /usr/local/bin/oxidized-report-git-commits; \
    \
    # Remove bundled libgit2 source and compilation artifacts
    # while retaining Rugged's compiled runtime extension.
    RUGGED_DIR="$(ruby -e 'print Gem::Specification.find_by_name("rugged").full_gem_path')"; \
    rm -rf \
      "${RUGGED_DIR}/vendor" \
      "${RUGGED_DIR}/ext"; \
    \
    # Remove downloaded gem archives
    if [ -d "${GEM_DIR}/cache" ]; then \
      find "${GEM_DIR}/cache" -type f -delete; \
    fi; \
    \
    # Remove temporary build dependencies
    apt-get purge -y \
      ruby-dev \
      g++ \
      make \
      cmake \
      pkg-config \
      libssl-dev \
      libssh2-1-dev \
      libicu-dev \
      zlib1g-dev \
      libzstd-dev \
      libyaml-dev \
      libsqlite3-dev \
      libffi-dev \
    ; \
    apt-get autoremove -y --purge; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*; \
    \
    # Validate dependencies after cleanup
    ruby -e 'require "rugged"; require "oxidized"; puts "Ruby dependencies OK"'; \
    test "$(ruby -e 'require "rugged"; print Rugged::VERSION')" = "${RUGGED_VERSION}"; \
    gem list --local --exact oxidized-web \
      --version "${OXIDIZED_WEB_VERSION}" --installed; \
    test "$(oxidized --version)" = "${OXIDIZED_VERSION}"; \
    test -x /usr/local/bin/oxidized-report-git-commits

# Create dedicated, unprivileged service account
RUN set -eux; \
    groupadd --system oxidized; \
    useradd --system \
      --gid oxidized \
      --home-dir /home/oxidized \
      --create-home \
      --shell /usr/sbin/nologin \
      oxidized; \
    mkdir -p "${OXIDIZED_HOME}" /var/lib/oxidized; \
    chown -R oxidized:oxidized \
      "${OXIDIZED_HOME}" \
      /var/lib/oxidized \
      /home/oxidized

USER oxidized
WORKDIR ${OXIDIZED_HOME}

EXPOSE 8888/tcp

STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["oxidized"]
